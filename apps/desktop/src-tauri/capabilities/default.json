{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default-deny capability set. Only allowlisted plugins and explicit AETHER-OS commands are permitted.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:event:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "shell:allow-open",
    "fs:default",
    "dialog:default",
    "os:default",
    "store:default"
  ]
}
