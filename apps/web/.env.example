# Supabase connection for the AETHER-OS web SPA.
#
# Copy to `.env.local` for local dev, or set these as Environment Variables
# in the Vercel project. When BOTH are present the app uses the real
# Supabase backend (auth + data); when either is missing it runs in demo
# mode with local data and the dev-mode role picker.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
