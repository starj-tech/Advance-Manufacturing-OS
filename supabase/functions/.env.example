# Secrets for the SaaS Edge Functions. Set per-project with:
#   supabase secrets set KEY=value
# Never commit real values. The functions degrade safely when a secret is
# absent (create-checkout/stripe-webhook => 500 "not configured";
# send-welcome-email => 200 { sent: false }), so nothing leaks or half-runs.

# --- create-checkout + stripe-webhook (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD_NODE_MONTHLY=
STRIPE_PRICE_STANDARD_NODE_ANNUAL=
STRIPE_PRICE_ADVANCED_AUTOMATA_MONTHLY=
STRIPE_PRICE_ADVANCED_AUTOMATA_ANNUAL=
STRIPE_PRICE_GLOBAL_ENTERPRISE_MONTHLY=
STRIPE_PRICE_GLOBAL_ENTERPRISE_ANNUAL=
CHECKOUT_SUCCESS_URL=https://app.aether-os.com/welcome?intent={INTENT}
CHECKOUT_CANCEL_URL=https://app.aether-os.com/pricing

# --- provisioning (stripe-webhook) — service role creates auth users + rows ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WELCOME_EMAIL_URL=https://<project-ref>.functions.supabase.co/send-welcome-email

# --- send-welcome-email (Resend) ---
RESEND_API_KEY=
RESEND_FROM=AETHER-OS <welcome@aether-os.com>
